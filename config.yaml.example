# ============================================================
# mcp_plat-console 主程序配置文件示例
# 复制为 config.yaml 后启动（或通过 CONFIG_PATH 环境变量指定路径）：
#   cp config.yaml.example config.yaml
# ============================================================

# 主程序数据库（用户、角色、AccessKey、服务器、系统设置等）
# type 可选：postgres / mysql
database:
  type: postgres
  postgres:
    host: 127.0.0.1
    port: 5432
    user: root
    password: 123456
    dbname: mcp_plat_db
  # 使用 MySQL 时，启用下方配置并删除上方 postgres 配置，将 type 改为 mysql：
  # mysql:
  #   host: 127.0.0.1
  #   port: 3306
  #   user: root
  #   password: 123456
  #   dbname: mcp_plat_db

# ============================================================
# 审计日志存储（与 audit-log-server 共用，写入/查询目标一致）
# type 可选：postgres / mysql / clickhouse
# 注意：主程序读取端也必须配置相同的存储类型，否则查不到数据。
# ============================================================
audit_log_db:
  type: clickhouse
  # 使用关系库（postgres）时，启用下方配置并将 type 改为 postgres：
  # postgres:
  #   host: 127.0.0.1
  #   port: 5432
  #   user: root
  #   password: 123456
  #   dbname: mcp_history_db
  # 使用 ClickHouse（高量级）时启用下方配置：
  clickhouse:
    addr: 127.0.0.1:9000
    user: default
    password: ""
    db: default
    table: audit_logs
    engine: merge_tree               # 单机：merge_tree；集群：replicated_merge_tree
    cluster: ""                      # replicated_merge_tree 时必填
    ttl_days: 90                     # 数据保留天数（ClickHouse 原生 TTL，自动清理）

# 密钥需至少 32 字符随机值，生产环境建议通过环境变量注入
jwt_secret: changeme-please-generate-a-random-32-char-string
access_key_secret: changeme-another-random-32-char-string

# HTTP 监听端口（可被 -port 命令行参数覆盖）
server_port: 8080

# 默认管理员账号（首次启动时初始化使用）
admin:
  username: admin
  password: admin123
