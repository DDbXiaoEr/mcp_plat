# 主程序数据库
DB_HOST=localhost
DB_PORT=5432
DB_USER=root
DB_PASSWORD=123456
DB_NAME=mcp_platform

# 审计日志存储（与 audit_log_server.yml 保持一致）
# 关系库：
AUDIT_LOG_TYPE=postgres
AUDIT_LOG_HOST=localhost
AUDIT_LOG_PORT=5432
AUDIT_LOG_USER=root
AUDIT_LOG_PASSWORD=123456
AUDIT_LOG_DB=mcp_history_db
# ClickHouse（AUDIT_LOG_TYPE=clickhouse 时启用）：
# AUDIT_LOG_CK_ADDR=127.0.0.1:9000
# AUDIT_LOG_CK_USER=default
# AUDIT_LOG_CK_PASSWORD=
# AUDIT_LOG_CK_DB=mcp_platform
# AUDIT_LOG_CK_TABLE=audit_logs
# AUDIT_LOG_CK_ENGINE=merge_tree
# AUDIT_LOG_CK_CLUSTER=
# AUDIT_LOG_CK_TTL_DAYS=90
# 关系库旧数据保留天数（0 表示不清理）：
# AUDIT_LOG_RETENTION_DAYS=90

JWT_SECRET=mcp-platform-secret-key
SERVER_PORT=8080

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
