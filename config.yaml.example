# ============================================================
# mcp_plat-console 主程序配置文件示例
# 复制为 config.yaml 后启动（或通过 CONFIG_PATH 环境变量指定路径）：
#   cp config.yaml.example config.yaml
# ============================================================

# 主程序数据库（用户、角色、AccessKey、服务器、系统设置等）
# type 可选：postgres / mysql
database:
  type: postgres
  postgres:
    host: 127.0.0.1
    port: 5432
    user: root
    password: 123456
    dbname: mcp_plat_db
  # 使用 MySQL 时，启用下方配置并删除上方 postgres 配置，将 type 改为 mysql：
  # mysql:
  #   host: 127.0.0.1
  #   port: 3306
  #   user: root
  #   password: 123456
  #   dbname: mcp_plat_db

# ============================================================
# 审计日志存储（与 audit-log-server 共用，写入/查询目标一致）
# type 可选：postgres / mysql / clickhouse
# 注意：主程序读取端也必须配置相同的存储类型，否则查不到数据。
# ============================================================
audit_log_db:
  type: clickhouse
  # 使用关系库（postgres）时，启用下方配置并将 type 改为 postgres：
  # postgres:
  #   host: 127.0.0.1
  #   port: 5432
  #   user: root
  #   password: 123456
  #   dbname: mcp_history_db
  # 使用 ClickHouse（高量级）时启用下方配置：
  clickhouse:
    addr: 127.0.0.1:9000
    user: default
    password: ""
    db: default
    table: audit_logs
    engine: merge_tree               # 单机：merge_tree；集群：replicated_merge_tree
    cluster: ""                      # replicated_merge_tree 时必填
    ttl_days: 90                     # 数据保留天数（ClickHouse 原生 TTL，自动清理）

# Redis（用户 Cookie Session 存储）
redis:
  addr: 127.0.0.1:6379
  password: ""
  db: 0

# Cookie Session（HttpOnly，登录后由服务端下发）
session:
  cookie_name: mcp_session
  max_age: 86400          # 秒，默认 24 小时；每次鉴权成功会滑动续期
  secure: false           # HTTPS 部署时请设为 true
  same_site: lax          # lax / strict / none（none 时必须 secure: true）

# 密钥需至少 32 字符随机值，生产环境建议通过环境变量注入
access_key_secret: changeme-another-random-32-char-string

# HTTP 监听端口（可被 -port 命令行参数覆盖）
server_port: 8080

# 管理员账号（节点角色开关）
# enabled: true  控制节点 —— 可使用下方管理员账号密码登录进行平台设置
# enabled: false 服务节点 —— 禁用管理员登录，仅使用系统设置中配置的认证方式（LDAP/CAS）；
#                未配置其它认证方式时登录直接返回错误
# 省略 enabled 时默认 true（兼容旧配置）
admin:
  enabled: true
  username: admin
  password: admin123
